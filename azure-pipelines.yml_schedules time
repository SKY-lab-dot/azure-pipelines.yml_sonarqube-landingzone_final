trigger:
non
  branches:
    include:
    - main
    - features*

# ============================================================
# SCHEDULE - Every 30 Minutes
# ============================================================

schedules:
- cron: "*/30 * * * *"
  displayName: 'Every 30 minutes'
  branches:
    include:
    - main
  always: true

# ============================================================
# AGENT POOL
# ============================================================

pool:
  name: Azurecicd

# ============================================================
# VARIABLE GROUP
# ============================================================

variables:
- group: dev

# ============================================================
# CI
# ============================================================

stages:

- stage: CI
  displayName: 'Terraform CI'

  jobs:

  - job: Init
    displayName: 'Terraform Init'

    steps:

    - checkout: self

    - task: TerraformInstaller@1
      displayName: 'Terraform Install'
      inputs:
        terraformVersion: '$(TF_VERSION)'

    - task: TerraformTask@5
      displayName: 'Terraform Init'
      inputs:
        provider: 'azurerm'
        command: 'init'
        backendServiceArm: '$(TF_SERVICE_CONNECTION)'
        backendAzureRmResourceGroupName: '$(resource_group_name)'
        backendAzureRmStorageAccountName: '$(storage_account_name)'
        backendAzureRmContainerName: '$(container_name)'
        backendAzureRmKey: '$(key)'

# ============================================================
# VALIDATE
# ============================================================

- stage: Validate
  displayName: 'Terraform Validate'
  dependsOn: CI

  jobs:

  - job: ValidateJob
    displayName: 'Terraform Validate'

    steps:

    - checkout: self

    - task: TerraformInstaller@1
      displayName: 'Terraform Install'
      inputs:
        terraformVersion: '$(TF_VERSION)'

    - task: TerraformTask@5
      displayName: 'Terraform Init for Validate'
      inputs:
        provider: 'azurerm'
        command: 'init'
        backendServiceArm: '$(TF_SERVICE_CONNECTION)'
        backendAzureRmResourceGroupName: '$(resource_group_name)'
        backendAzureRmStorageAccountName: '$(storage_account_name)'
        backendAzureRmContainerName: '$(container_name)'
        backendAzureRmKey: '$(key)'

    - task: TerraformTask@5
      displayName: 'Terraform Validate'
      inputs:
        provider: 'azurerm'
        command: 'validate'

# ============================================================
# PLAN
# ============================================================

- stage: Plan
  displayName: 'Terraform Plan'
  dependsOn: Validate

  jobs:

  - job: PlanJob
    displayName: 'Terraform Plan'

    steps:

    - checkout: self

    - task: TerraformInstaller@1
      displayName: 'Terraform Install'
      inputs:
        terraformVersion: '$(TF_VERSION)'

    - task: TerraformTask@5
      displayName: 'Terraform Init for Plan'
      inputs:
        provider: 'azurerm'
        command: 'init'
        backendServiceArm: '$(TF_SERVICE_CONNECTION)'
        backendAzureRmResourceGroupName: '$(resource_group_name)'
        backendAzureRmStorageAccountName: '$(storage_account_name)'
        backendAzureRmContainerName: '$(container_name)'
        backendAzureRmKey: '$(key)'

    - task: TerraformTask@5
      displayName: 'Terraform Plan'
      inputs:
        provider: 'azurerm'
        command: 'plan'
        environmentServiceNameAzureRM: '$(TF_SERVICE_CONNECTION)'

# ============================================================
# CD / APPLY
# ============================================================

- stage: CD
  displayName: 'Terraform Apply'
  dependsOn: Plan

  jobs:

  - job: ApplyJob
    displayName: 'Terraform Apply'

    steps:

    - checkout: self

    - task: TerraformInstaller@1
      displayName: 'Terraform Install'
      inputs:
        terraformVersion: '$(TF_VERSION)'

    - task: TerraformTask@5
      displayName: 'Terraform Init for Apply'
      inputs:
        provider: 'azurerm'
        command: 'init'
        backendServiceArm: '$(TF_SERVICE_CONNECTION)'
        backendAzureRmResourceGroupName: '$(resource_group_name)'
        backendAzureRmStorageAccountName: '$(storage_account_name)'
        backendAzureRmContainerName: '$(container_name)'
        backendAzureRmKey: '$(key)'

    - task: TerraformTask@5
      displayName: 'Terraform Apply'
      inputs:
        provider: 'azurerm'
        command: 'apply'
        environmentServiceNameAzureRM: '$(TF_SERVICE_CONNECTION)'